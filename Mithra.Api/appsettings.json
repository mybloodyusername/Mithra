{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=mithra"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyForJWTTokenGeneration123!ChangeThisInProduction",
    "Issuer": "MithraAPI",
    "Audience": "MithraClient",
    "ExpirationDays": 30
  },
  "CorsSettings": {
    "DevelopmentOrigin": "http://localhost:4200",
    "ProductionOrigin": "https://website.com"
  }
}
